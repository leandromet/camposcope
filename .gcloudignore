# Controls what `gcloud run deploy --source .` uploads as build context.
# Without this file gcloud falls back to .gitignore, which does NOT exclude
# data/cache — several megabytes of a derived biome GeoJSON with no business in
# a build context (it is rebuilt from Earth Engine on first request).
# Kept in sync with .dockerignore.

# Version control
.git
.gitignore
.gitattributes

# Python artefacts
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
*.egg-info
dist
build

# Virtual environments
.venv
venv
env

# Secrets — never bake credentials into the image
.env
.env.local
*service-account*.json
*-key.json
credentials.json

# Reflex runtime artefacts (regenerated by `reflex init` during the build)
.web
.states
reflex.db
node_modules

# Rebuildable at runtime — see Dockerfile and .dockerignore
data/cache

# Not needed to run the service
tests
doc
scripts
*.md
!README.md

# Editor / OS
.vscode
.idea
.DS_Store
*.swp
