# Camposcope — copy to .env and edit. Full table: doc/09-dev-environment.md §4.

# --- Earth Engine ---------------------------------------------------------
# The Partner-tier grant is attached to THIS project. A different one does not
# fail, it silently drops to contributor limits and the tile fan-out crawls.
CS_GCP_PROJECT_ID=ee-leandromet
# Deployment path; leave unset locally and use `earthengine authenticate` (ADC).
# CS_EE_SERVICE_ACCOUNT_JSON=
# CS_EE_SERVICE_ACCOUNT_FILE=

# --- CAR GeoServer --------------------------------------------------------
CS_SICAR_BASE=https://geoserver.car.gov.br/geoserver/sicar/ows
CS_SICAR_WMS=https://geoserver.car.gov.br/geoserver/sicar/wms
CS_SICAR_TIMEOUT_CONNECT=10
CS_SICAR_TIMEOUT_READ=60
CS_SICAR_CACHE_TTL=3600
# Set to false only if the certificate chain fails for you, and say so out loud.
CS_SICAR_VERIFY_TLS=true

# --- SPOT 2008 (doc/12) ---------------------------------------------------
# Licence-gated: requires the "Brazil Forest Imagery Dataset 2008" agreement on
# the service account. Set to false for a deployment whose account lacks it —
# the layers are then dropped from the panel rather than offered and failing.
CS_SPOT_ENABLED=true

# --- Place search (doc/11 §5) ---------------------------------------------
# Nominatim's usage policy caps this at ~1 req/s and forbids bulk use. It is the
# LAST of four resolvers; codes, coordinates and municípios never reach it.
CS_GEOCODER_ENABLED=true
CS_GEOCODER_URL=https://nominatim.openstreetmap.org/search

# --- Municípios (doc/11 §4) -----------------------------------------------
# The LIST comes from data/municipios.csv (committed). This asset supplies the
# GEOMETRY, for framing and clipping. Leave empty until it is published.
# CS_MUNICIPIOS_ASSET=projects/ee-leandromet/assets/ibge_municipios

# --- Analysis -------------------------------------------------------------
# Rings measured OUTWARD FROM THE BOUNDARY, in metres (decision D3).
CS_RING_RADII_M=500,2000,5000
CS_EE_SCALE_M=30
CS_EE_TILE_SCALE=4
CS_SANKEY_MIN_YEAR_GAP=5

# --- Map ------------------------------------------------------------------
# NOTE: the Google tile endpoints are undocumented and not a licensed API.
# Fine for local development; must become a Maps Platform key or Esri/OSM
# before any public deployment. See doc/04-data-sources.md §7.
CS_BASEMAP=google_hybrid

# --- Ports ----------------------------------------------------------------
# Chosen to collide with nothing else on this machine (doc/09 §2).
PORT=3020
BACKEND_PORT=8021
