# Version control
.git
.gitignore
.gitattributes

# Python artefacts
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
*.egg-info
dist
build

# Virtual environments
.venv
venv
env

# Secrets — never bake credentials into the image
.env
.env.local
*service-account*.json
*-key.json
credentials.json

# Reflex runtime artefacts (regenerated by `reflex init` during the build)
.web
.states
reflex.db
node_modules

# Rebuildable at runtime (services/biomes.py caches the biome GeoJSON here on
# first request) — data/municipios.csv, data/uf_boundaries.simplified.geojson,
# data/territorios.csv and the two data/*.geojson.gz territory overlays are NOT
# under data/cache and stay in the image; see Dockerfile.
data/cache

# Not needed to run the service
tests
doc
scripts
*.md
!README.md

# Editor / OS
.vscode
.idea
.DS_Store
*.swp
